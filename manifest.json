{
  "manifest_version": 3,
  "name": "Opencart Sesli Not Asistanı",
  "version": "1.4.0",
  "description": "Opencart müşteri notları, EczaneVPN asistanı, HD Duvar Kağıdı ve Versiyon Yöneticisi.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardRead",
    "alarms",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://magaza.alternet.com.tr/*",
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://magaza.alternet.com.tr/*",
        "file:///*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ses Asistanı Kontrolü"
  }
}
