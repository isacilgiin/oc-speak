{
  "manifest_version": 3,
  "name": "Alternet Mercury & OpenCart Asistanı",
  "version": "2.0.5",
  "description": "Mercury Portal ve OpenCart için Sesli Asistan, EczaneVPN Onay Notu, Netsipp Arama, Modern Liste & Not Görünümü.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardRead",
    "alarms",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://panel.alternet.dev.alter.net.tr/*",
    "*://*.alter.net.tr/*",
    "*://*.alternet.com.tr/*",
    "*://magaza.alternet.com.tr/*",
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://panel.alternet.dev.alter.net.tr/*",
        "*://*.alter.net.tr/*",
        "*://*.alternet.com.tr/*",
        "*://magaza.alternet.com.tr/*",
        "file:///*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ses Asistanı Kontrolü"
  }
}
